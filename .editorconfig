root = true

# ==============================================================================
# Global
# ==============================================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space

# ==============================================================================
# .NET / C#
# ==============================================================================

[*.{cs,csx}]
indent_size = 4
tab_width = 4

# ------------------------------------------------------------------------------
# Usings
# ------------------------------------------------------------------------------

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_using_directive_placement = outside_namespace:warning

# ------------------------------------------------------------------------------
# Namespaces
# ------------------------------------------------------------------------------

csharp_style_namespace_declarations = file_scoped:warning

# ------------------------------------------------------------------------------
# var
#
# Prefer var ALWAYS for local variables.
# Examples:
#
#   var count = 10;
#   var name = "foo";
#   var service = GetService();
#   var client = new HttpClient();
#
# Instead of:
#
#   int count = 10;
#   string name = "foo";
#   IService service = GetService();
#   HttpClient client = new HttpClient();
# ------------------------------------------------------------------------------

csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

# Explicitly enforce IDE0007 ("Use var")
dotnet_diagnostic.IDE0007.severity = error

# `new()` and "var everywhere" don't compose particularly well:
#
#   Foo foo = new();     -> violates var rule
#   var foo = new Foo(); -> preferred
#
# Prefer explicit constructor type so var can infer it.
csharp_style_implicit_object_creation_when_type_is_apparent = false:suggestion

# ------------------------------------------------------------------------------
# Braces
#
# Single statement:
#
#   if (condition)
#       Execute();
#
# Multiline:
#
#   if (condition)
#   {
#       Execute();
#       Log();
#   }
# ------------------------------------------------------------------------------

csharp_prefer_braces = when_multiline:error
dotnet_diagnostic.IDE0011.severity = error

# Don't keep statements like:
#
#   if (condition) Execute();
#
csharp_preserve_single_line_statements = false

# ------------------------------------------------------------------------------
# Brace / newline formatting
# ------------------------------------------------------------------------------

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# ------------------------------------------------------------------------------
# Expression-bodied members
#
# Prefer:
#
#   public string Name => _name;
#
#   public int GetCount() => _items.Count;
#
#   public bool IsValid() => Value is not null;
#
# Instead of:
#
#   public int GetCount()
#   {
#       return _items.Count;
#   }
# ------------------------------------------------------------------------------

csharp_style_expression_bodied_methods = true:warning
csharp_style_expression_bodied_constructors = true:warning
csharp_style_expression_bodied_operators = true:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = true:warning

# ------------------------------------------------------------------------------
# Modern C# syntax
# ------------------------------------------------------------------------------

# using var stream = ...
csharp_prefer_simple_using_statement = true:warning

# static local functions / lambdas when captures aren't needed
csharp_prefer_static_local_function = true:warning
csharp_prefer_static_anonymous_function = true:suggestion

# Prefer switch expressions
csharp_style_prefer_switch_expression = true:warning

# Pattern matching
csharp_style_prefer_pattern_matching = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:suggestion

# Null handling
csharp_style_conditional_delegate_call = true:warning
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Throw expressions
csharp_style_throw_expression = true:warning

# Prefer inline out variables
csharp_style_inlined_variable_declaration = true:warning

# Prefer deconstruction where appropriate
csharp_style_deconstructed_variable_declaration = true:suggestion

# Prefer ^1 / ranges
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

# Prefer primary constructors when Roslyn considers conversion appropriate.
# Kept as suggestion because this can be highly subjective.
csharp_style_prefer_primary_constructors = true:suggestion

# ------------------------------------------------------------------------------
# General .NET style
# ------------------------------------------------------------------------------

# readonly fields where possible
dotnet_style_readonly_field = true:warning

# foo?.Bar instead of foo == null ? null : foo.Bar
dotnet_style_null_propagation = true:warning

# foo ?? bar
dotnet_style_coalesce_expression = true:warning

# Prefer auto-properties
dotnet_style_prefer_auto_properties = true:suggestion

# Prefer object/collection initializers
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning

# Prefer inferred tuple/anonymous member names
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion

# Simplifications
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning

# Prefer compound assignments: x += y
dotnet_style_prefer_compound_assignment = true:suggestion

# ------------------------------------------------------------------------------
# Qualification
#
# Prefer:
#   Foo()
#   Value
#
# Instead of:
#   this.Foo()
#   this.Value
# ------------------------------------------------------------------------------

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ------------------------------------------------------------------------------
# Parentheses
# ------------------------------------------------------------------------------

dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:suggestion

# ------------------------------------------------------------------------------
# C# indentation
# ------------------------------------------------------------------------------

csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# ------------------------------------------------------------------------------
# C# spacing
# ------------------------------------------------------------------------------

csharp_space_after_cast = false

csharp_space_after_comma = true
csharp_space_before_comma = false

csharp_space_after_dot = false
csharp_space_before_dot = false

csharp_space_after_colon_in_inheritance_clause = true
csharp_space_before_colon_in_inheritance_clause = true

csharp_space_around_binary_operators = before_and_after

csharp_space_after_keywords_in_control_flow_statements = true

csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# ==============================================================================
# Roslynator
# ==============================================================================

# Add braces when embedded statement itself is multiline
dotnet_diagnostic.RCS1001.severity = warning

# Remove unnecessary braces around a single statement
dotnet_diagnostic.RCS1002.severity = warning

# Same behavior for if/else chains
dotnet_diagnostic.RCS1003.severity = warning
dotnet_diagnostic.RCS1004.severity = warning

# ------------------------------------------------------------------------------
# C# modifiers
# ------------------------------------------------------------------------------

csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion

# ==============================================================================
# .NET project files / XML
# ==============================================================================

[*.{csproj,fsproj,vbproj,props,targets,nuspec,xml,config,slnx}]
indent_style = space
indent_size = 2
tab_width = 2

# ==============================================================================
# Frontend — JavaScript / TypeScript
#
# Semantic formatting (quotes, semi, trailing commas, etc.) should be handled by
# ESLint / Prettier. EditorConfig handles the universal file-level conventions.
# ==============================================================================

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2
tab_width = 2

# ==============================================================================
# Frontend — styles
# ==============================================================================

[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2
tab_width = 2

# ==============================================================================
# Frontend — markup
# ==============================================================================

[*.{html,htm}]
indent_style = space
indent_size = 2
tab_width = 2

# ==============================================================================
# JSON
# ==============================================================================

[*.{json,jsonc}]
indent_style = space
indent_size = 2
tab_width = 2

# ==============================================================================
# YAML
# ==============================================================================

[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

trim_trailing_whitespace = true
insert_final_newline = true

# ==============================================================================
# Markdown
# ==============================================================================

[*.md]
indent_style = space
indent_size = 2
tab_width = 2

# Markdown uses two trailing spaces for an explicit <br>, so don't strip them.
trim_trailing_whitespace = false
insert_final_newline = true
