{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sensors.meshsmo.ru/schemas/sensor-registry-v1.json",
  "title": "MeshSMO sensor registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "displayName", "mesh", "polling", "public", "metrics"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){1,61}[a-z0-9]$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey", "protocol"],
      "properties": {
        "publicKey": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "loginPassword": {
          "type": "string",
          "description": "Node login password; ${VAR} / ${VAR:-default} are substituted from the environment. Empty string = node has no password; omitted = fall back to the global SensorPolling:LoginPassword. Max 15 bytes of UTF-8.",
          "maxLength": 128
        }
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval", "timeout", "maxAttempts", "enabled"],
      "properties": {
        "interval": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "enabled": { "type": "boolean" },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeZone", "windows"],
          "description": "Optional gateway-only time-of-day polling schedule; outside the windows the base interval applies.",
          "properties": {
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "description": "IANA time zone id (e.g. 'Europe/Moscow') used to interpret the window times."
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "interval"],
                "description": "Half-open [from, to) local-time window; 'to' <= 'from' wraps past midnight.",
                "properties": {
                  "from": { "$ref": "#/$defs/timeOfDay" },
                  "to": { "$ref": "#/$defs/timeOfDay" },
                  "interval": { "$ref": "#/$defs/duration" }
                }
              }
            }
          }
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "indexable"],
      "properties": {
        "visible": { "type": "boolean" },
        "indexable": { "type": "boolean" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "precision"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "metric"],
            "properties": {
              "channel": { "type": "integer", "minimum": 0, "maximum": 255 },
              "type": {
                "type": "string",
                "description": "Cayenne LPP type key (e.g. 'voltage', 'temperature') or '*' for any type."
              },
              "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "displayName": { "type": "string" },
              "unit": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(?:ms|s|m|h|d)$"
    },
    "timeOfDay": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
