<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6578810">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <BuildCommand>npm run build:dotnet</BuildCommand>
    <TestCommand>npm test</TestCommand>
    <ShouldRunNpmInstall Condition="'$(CI)' != 'true'">true</ShouldRunNpmInstall>
    <ShouldRunNpmInstall Condition="'$(CI)' == 'true'">false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\build\client</BuildOutputFolder>
  </PropertyGroup>
</Project>
