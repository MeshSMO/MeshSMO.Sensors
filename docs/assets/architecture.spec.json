      "to": "pg",
      "label": "Npgsql",
      "labelDy": -30
    },
    {
      "id": "read",
      "from": "api",
      "to": "pg",
      "label": "чтение",
      "labelDy": 24
    },
    {
      "id": "view",
      "from": "browser",
      "to": "spa",
      "label": "HTTPS"
    },
    {
      "id": "client-api",
      "from": "spa",
      "to": "api",
      "label": "fetch /api/v1",
      "variant": "dashed",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Радиоконтур",
      "items": [
        "Опрос pull-only нод через acquisition API прошивки репитера",
        "ANON-логин bootstrap, retry с randomized backoff, per-sensor расписания",
        "Альтернативный канал — стоковый компаньон (companion frame protocol)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Доставка ровно-однажды",
      "items": [
        "SQLite outbox переживает рестарты web",
        "Режимы pull (web опрашивает gateway) и push (gateway постит сам)",
        "Ack только после успешного коммита в PostgreSQL"
      ]
    },
    {
      "dot": "violet",
      "title": "Отображение",
      "items": [
        "BFF: /api/v1, OpenAPI, rate limit per-IP",
        "Статический prerender индексируемых страниц + SPA-fallback",
        "On-demand прогноз ML.NET SSA за флагом Forecasting:Enabled"
      ]
    }
  ]
}