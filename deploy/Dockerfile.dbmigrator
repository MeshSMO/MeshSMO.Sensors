FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/MeshSMO.Sensors.Domain/*.csproj src/MeshSMO.Sensors.Domain/
COPY src/MeshSMO.Sensors.Application/*.csproj src/MeshSMO.Sensors.Application/
COPY src/MeshSMO.Sensors.Infrastructure/*.csproj src/MeshSMO.Sensors.Infrastructure/
COPY src/MeshSMO.Sensors.DbMigrator/*.csproj src/MeshSMO.Sensors.DbMigrator/
RUN dotnet restore src/MeshSMO.Sensors.DbMigrator/MeshSMO.Sensors.DbMigrator.csproj
# Keep unrelated services out of this layer so their source changes do not
# invalidate the restore/publish cache for dbmigrator.
COPY src/MeshSMO.Sensors.Domain/ src/MeshSMO.Sensors.Domain/
COPY src/MeshSMO.Sensors.Application/ src/MeshSMO.Sensors.Application/
COPY src/MeshSMO.Sensors.Infrastructure/ src/MeshSMO.Sensors.Infrastructure/
COPY src/MeshSMO.Sensors.DbMigrator/ src/MeshSMO.Sensors.DbMigrator/
RUN dotnet publish src/MeshSMO.Sensors.DbMigrator/MeshSMO.Sensors.DbMigrator.csproj \
    --configuration Release --output /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
LABEL org.opencontainers.image.description="One-shot migrator for MeshSMO Sensors: applies EF Core migrations and syncs the YAML sensor registry into PostgreSQL."
COPY --from=build /app/publish ./
# Sensor registry YAMLs are deployment-local and sensitive (may resolve node
# passwords from env); they are mounted at runtime via compose, not baked in.
# /app/logs hosts the Serilog file sink; it must be writable by APP_UID.
RUN mkdir -p /app/logs && chown -R $APP_UID /app/logs
USER $APP_UID
ENTRYPOINT ["dotnet", "MeshSMO.Sensors.DbMigrator.dll"]
