FROM node:26-alpine AS frontend
WORKDIR /src/src/web
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web/ ./
COPY config/ /src/config/
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS backend
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/MeshSMO.Sensors.Domain/*.csproj src/MeshSMO.Sensors.Domain/
COPY src/MeshSMO.Sensors.Application/*.csproj src/MeshSMO.Sensors.Application/
COPY src/MeshSMO.Sensors.Forecasting/*.csproj src/MeshSMO.Sensors.Forecasting/
COPY src/MeshSMO.Sensors.Infrastructure/*.csproj src/MeshSMO.Sensors.Infrastructure/
COPY src/MeshSMO.Sensors.Web/*.csproj src/MeshSMO.Sensors.Web/
COPY src/web/*.esproj src/web/
RUN dotnet restore src/MeshSMO.Sensors.Web/MeshSMO.Sensors.Web.csproj \
    /p:ShouldRunNpmInstall=false
COPY src/ src/
RUN dotnet publish src/MeshSMO.Sensors.Web/MeshSMO.Sensors.Web.csproj \
    --configuration Release --output /app/publish --no-restore \
    /p:SkipFrontendBuild=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=backend /app/publish ./
COPY --from=frontend /src/src/web/.output/public ./wwwroot
ENV ASPNETCORE_HTTP_PORTS=8080
# curl is needed by the compose healthcheck (/health/ready). ML.NET TimeSeries
# loads libMklImports.so, which requires the OpenMP runtime as libiomp5.so.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libomp5 \
    && omp_path="$(find /usr/lib -name libomp.so.5 -print -quit)" \
    && test -n "$omp_path" \
    && { test -e "$(dirname "$omp_path")/libiomp5.so" \
        || ln -s "$(basename "$omp_path")" "$(dirname "$omp_path")/libiomp5.so"; } \
    && ldd /app/runtimes/linux-x64/native/libMklImports.so | grep -q 'libiomp5.so => /' \
    && rm -rf /var/lib/apt/lists/*
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "MeshSMO.Sensors.Web.dll"]
