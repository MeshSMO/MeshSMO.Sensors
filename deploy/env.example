POSTGRES_DB=meshsmo_sensors
POSTGRES_USER=meshsmo
POSTGRES_PASSWORD=change-me
PUBLIC_BASE_URL=https://sensors.meshsmo.ru
SENSOR_WEB_PORT=8080
# On-demand ML.NET forecast API. Enable only after profiling real series.
FORECASTING_ENABLED=false
# Lenient mode: skips staleness/gap/coverage/history/quality gates — a forecast is
# built from imperfect data whenever ML.NET can technically produce one. Metrics in
# `model` diagnostics stay honest; use consciously.
FORECASTING_LENIENT_MODE=false
FORECASTING_MINIMUM_HISTORY_1H_DAYS=3
FORECASTING_MINIMUM_HISTORY_6H_DAYS=3
FORECASTING_MINIMUM_HISTORY_12H_DAYS=5
FORECASTING_MINIMUM_HISTORY_24H_DAYS=7
MESHCORE_HOST_DEVICE=/dev/serial/by-id/usb-replace-me
MESHCORE_MODE=Serial
# Сбор панельной телеметрии репитера (core.*, archive.*, history.*, ...) в outbox.
# По умолчанию выключена: main API её не потребляет, а статус репитера утекает в хранилище.
MESHCORE_TELEMETRY_COLLECTION_ENABLED=false
MESHCORE_HTTP_BASE_ADDRESS=https://192.168.1.123
MESHCORE_HTTP_ADMIN_PASSWORD=change-me
MESHCORE_HTTP_ALLOW_INVALID_CERTIFICATE=true
# Опрос через стоковый компаньон вместо репитера: MESHCORE_MODE=Companion —
# companion frame protocol по TCP (Wi-Fi-сборки компаньона слушают порт 5000).
# Отличия от репитерного канала: ответы без RSSI/SNR, один запрос в полёте,
# компаньон должен слышать ноду напрямую (zero-hop).
# MESHCORE_MODE=Companion
MESHCORE_COMPANION_HOST=192.168.1.234
MESHCORE_COMPANION_PORT=5000
GATEWAY_API_KEY=
SENSOR_LOGIN_PASSWORD=
SENSOR_POLL_INTERVAL_OVERRIDE=60
# Индивидуальные пароли нод: в config/sensors/*.yaml задаётся mesh.loginPassword: ${VAR}
# (или ${VAR:-default}); пустая строка = у ноды нет пароля, поле без значения = общий
# SENSOR_LOGIN_PASSWORD. Переменные из .env прокидываются в gateway/dbmigrator через
# env_file; литеральный "$" в значении экранируйте как "$$".
# NODE_ONE_PASSWORD=
# NODE_TWO_PASSWORD=
# Доставка телеметрии: pull (по умолчанию) или push. Для push задай оба ключа
# (значение GATEWAY_INGEST_API_KEY должно совпадать с GATEWAY_PUSH_API_KEY).
GATEWAY_MODE=Pull
GATEWAY_INGEST_API_KEY=
GATEWAY_PUSH_API_URL=
GATEWAY_PUSH_API_KEY=
GATEWAY_PUSH_ALLOW_INSECURE_HTTP=false
# Логи: Serilog пишет в консоль и в файл (/app/logs, rolling по дню, 14 файлов
# по 128 МиБ). EF SQL-команды идут только в файл, консоль их не дублирует.
# Точечная подстройка уровней — через Serilog__*-переменные, например поднять
# порог SQL-запросов в файле до Warning:
# SERILOG_MINIMUMLEVEL_OVERRIDE_MICROSOFT.ENTITYFRAMEWORKCORE.DATABASE.COMMAND=Warning
