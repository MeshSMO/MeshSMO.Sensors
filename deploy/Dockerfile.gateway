FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/MeshSMO.Sensors.Domain/*.csproj src/MeshSMO.Sensors.Domain/
COPY src/MeshSMO.Sensors.Application/*.csproj src/MeshSMO.Sensors.Application/
COPY src/MeshSMO.Sensors.Infrastructure/*.csproj src/MeshSMO.Sensors.Infrastructure/
COPY src/MeshSMO.Sensors.Gateway/*.csproj src/MeshSMO.Sensors.Gateway/
RUN dotnet restore src/MeshSMO.Sensors.Gateway/MeshSMO.Sensors.Gateway.csproj
# Keep unrelated services and the frontend out of this layer so their source
# changes do not invalidate the restore/publish cache for gateway.
COPY src/MeshSMO.Sensors.Domain/ src/MeshSMO.Sensors.Domain/
COPY src/MeshSMO.Sensors.Application/ src/MeshSMO.Sensors.Application/
COPY src/MeshSMO.Sensors.Infrastructure/ src/MeshSMO.Sensors.Infrastructure/
COPY src/MeshSMO.Sensors.Gateway/ src/MeshSMO.Sensors.Gateway/
RUN dotnet publish src/MeshSMO.Sensors.Gateway/MeshSMO.Sensors.Gateway.csproj \
    --configuration Release --output /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
LABEL org.opencontainers.image.description="Telemetry gateway for MeshSMO Sensors: polls pull-only MeshCore/LoRa sensor nodes via the repeater and buffers batches in a SQLite outbox."
COPY --from=build /app/publish ./
# curl is needed by the compose healthcheck (/health/ready).
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
# /app/data hosts the SQLite outbox volume, /app/logs the Serilog file sink;
# both must be writable by APP_UID.
RUN mkdir -p /app/data /app/logs && chown -R $APP_UID /app/data /app/logs
USER $APP_UID
ENTRYPOINT ["dotnet", "MeshSMO.Sensors.Gateway.dll"]
