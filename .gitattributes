# Normalize line endings: repository and working tree are always LF.
# Both .editorconfig (end_of_line = lf) and Prettier (endOfLine: lf) require LF,
# so EOL must not depend on per-machine core.autocrlf settings.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never diff or normalize
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.db binary
*.dll binary
*.exe binary
*.snk binary
*.pfx binary
*.pem binary
